# ============================================================
# Tebarrot - Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versionar o .env real.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=tebarrot
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=tebarrot_estoque
# Usado PELOS CONTAINERS (api, ia-worker) para falar com o `db` via rede
# Docker interna. NÃO é a porta exposta no host — não mude isto por causa
# de conflito de porta na sua máquina, mude POSTGRES_HOST_PORT abaixo.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta exposta no HOST para acesso externo ao Postgres (psql, DBeaver etc).
# Só isto precisa mudar se a porta 5432 já estiver em uso na sua máquina.
POSTGRES_HOST_PORT=5433

# ---- API (Node.js) ----
NODE_ENV=production
API_PORT=3000
JWT_SECRET=troque_este_segredo_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=12h
DATASET_PATH=/dataset

# ---- IA Worker (V1) ----
IA_WORKER_URL=http://ia-worker:8000
IA_WORKER_ENABLED=false

# ---- Google Sheets (espelho de leitura) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=conta-servico@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=coloque_o_id_da_planilha_aqui
SHEETS_SYNC_ENABLED=true
SHEETS_SYNC_INTERVAL_MS=30000

# ---- Cloudflare Tunnel ----
# Gerado ao criar o túnel via `cloudflared tunnel login` / `cloudflared tunnel create`.
# NÃO é lido pelo docker-compose neste setup — o cloudflared roda como
# Serviço nativo do Windows (`cloudflared.exe service install <token>`),
# então o token foi passado direto na instalação do serviço, não via .env.
# Mantido aqui apenas como referência/backup do valor.
CLOUDFLARE_TUNNEL_TOKEN=coloque_o_token_do_tunnel_aqui

# ---- Cloudflare Access (autenticação obrigatória na borda) ----
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=minhaempresa.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=coloque_o_application_audience_aqui

# ---- Mobile App (build-time, Expo) ----
EXPO_PUBLIC_API_URL=https://sua-url-do-tunnel.trycloudflare.com
