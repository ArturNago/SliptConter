# URL base da API do SliptConter (sem a barra final e sem o prefixo /api).
# Usada em build-time pelo Vite (definida em window.__API_URL__).
# Produção (túnel Cloudflare):
VITE_API_URL=https://bemviverdecor.com.br
# Desenvolvimento local (API rodando na porta 3000 do host):
# VITE_API_URL=http://localhost:3000
