{
  "expo": {
    "name": "Tebarrot Estoque",
    "slug": "tebarrot-estoque",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para fotografar produtos e ler códigos durante a conferência de estoque.",
        "NSPhotoLibraryUsageDescription": "A galeria é usada para escolher uma foto do produto no catálogo."
      }
    },
    "android": {
      "package": "com.tebarrot.estoque",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "c417bc8b-3a52-40f4-9aa2-e8f4b1be76d6"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-image-picker"
    ],
    "owner": "arturnago"
  }
}
