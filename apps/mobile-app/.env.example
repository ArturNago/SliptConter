# URL da API.
#
# Opção 1 (produção/padrão): URL do Cloudflare Tunnel
#   EXPO_PUBLIC_API_URL=https://sua-url-do-tunnel.trycloudflare.com
#
# Opção 2 (desenvolvimento na mesma rede Wi-Fi do galpão):
#   EXPO_PUBLIC_API_URL=http://[IP_LOCAL_DA_MAQUINA_DA_API]:3000
#   Ex.: EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
#   (exige que a API esteja publicando a porta 3000 no host e que o
#    firewall do Windows permita conexões de entrada nessa porta)
#
# Nunca use localhost/127.0.0.1: no celular físico, isso aponta para o
# próprio aparelho.
EXPO_PUBLIC_API_URL=https://sua-url-do-tunnel.trycloudflare.com

