# Ver .env.example na raiz do projeto — este arquivo é apenas
# um espelho para desenvolvimento local da API isolada (fora do docker-compose).

NODE_ENV=development
API_PORT=3000
JWT_SECRET=dev-secret-troque-em-producao
JWT_EXPIRES_IN=12h
DATASET_PATH=./dataset

POSTGRES_USER=tebarrot
POSTGRES_PASSWORD=tebarrot
POSTGRES_DB=tebarrot_estoque
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

IA_WORKER_URL=http://localhost:8000
IA_WORKER_ENABLED=false

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
SHEETS_SYNC_ENABLED=false
SHEETS_SYNC_INTERVAL_MS=30000
